// 모니터링 반영 (Phase 4, docs/decisions/0008). watch 패키지가 보낸 FilesChanged 를 처리한다.
import "go:os"
import "go:path/filepath"
import "go:time"

import "model"
import "session"

/// 감시 중인 디렉터리에서 바뀐 `.jsonl` 경로들
pub struct FilesChanged {
  pub paths: Slice<string>,
}

/// 이 시간(초) 안에 수정된 세션은 열 때 맨 아래에서 시작한다(진행 중인 대화로 본다).
pub const LIVE_SECS = 300

impl App {
  /// 감시 디렉터리가 바뀔 때 호출할 함수 (main 에서 watch.Handle.add_dirs 를 연결)
  pub fn set_watch_hook(self: mut Ref<Self>, hook: fn(Slice<string>)) {
    self.watch_hook = Some(hook)
    hook(self.watch_dirs())
  }

  pub fn watch_dirs(self: Ref<Self>) -> Slice<string> {
    let mut dirs = self.dirs.clone()
    if self.has_conv {
      let d = filepath.Dir(self.current.path)
      if !dirs.contains(d) { dirs = dirs.append(d) }
    }
    dirs
  }

  fn notify_dirs(self: Ref<Self>) {
    if let Some(hook) = self.watch_hook { hook(self.watch_dirs()) }
  }

  pub fn on_files(self: mut Ref<Self>, paths: Slice<string>) {
    // update_meta 가 sessions 순서를 바꾸면 rows/cursor 가 다른 세션을 가리키므로 먼저 기억해 둔다
    let keep = self.selected().map_or("", |s| s.id)
    let mut list_changed = false
    for p in paths {
      if self.has_conv && p == self.current.path { self.refresh_conv() }
      if self.dirs.contains(filepath.Dir(p)) && session.is_session_file(
        filepath.Base(p),
      ) {
        self.update_meta(p)
        list_changed = true
      }
    }
    if list_changed {
      session.sort_sessions(self.sessions)
      self.apply_filter()
      self.select_id(keep)
    }
  }

  /// 목록 메타 한 건을 갱신/추가/삭제한다.
  fn update_meta(self: mut Ref<Self>, path: string) {
    let mut kept = Slice.new<model.Session>()
    for s in self.sessions {
      if s.path != path { kept = kept.append(s) }
    }
    if let Ok(s) = session.load_meta(path) { kept = kept.append(s) }
    self.sessions = kept
  }

  /// 열린 세션의 새 줄을 읽어 반영한다. follow 중이고 맨 아래였으면 따라 내려간다.
  pub fn refresh_conv(self: mut Ref<Self>) {
    let before = self.spans.length()
    let at_bottom = self.vp.AtBottom()
    let read = match session.feed(&self.conv, &self.tail) {
      Ok(r) => r,
      Err(e) => {
        self.status = f"읽기 실패: {e}"
        return
      },
    }
    if read.added == 0 && !read.reset { return }
    if self.follow && at_bottom {
      self.relayout_with(true)
      self.new_count = 0
    } else {
      self.relayout()
      let diff = self.spans.length() - before
      if diff > 0 { self.new_count += diff }
    }
    if let Some(next) = self.conv.continued_in {
      if next != self.announced_next {
        self.announced_next = next
        self.status = f"이어진 세션이 생겼습니다: {next} (o 로 열기)"
      }
    }
  }

  pub fn toggle_follow(self: mut Ref<Self>) {
    self.follow = !self.follow
    if self.follow {
      self.relayout_with(true)
      self.new_count = 0
      self.status = "follow 켜짐: 새 메시지를 따라갑니다"
    } else {
      self.status = "follow 꺼짐"
    }
  }

  /// continued-in 으로 이어진 세션을 연다.
  pub fn open_continued(self: mut Ref<Self>) {
    let Some(next) = self.conv.continued_in else {
      self.status = "이어진 세션이 없습니다"
      return
    }
    match session.find_session(self.opts.root, next) {
      Some(p) => self.open_path(p),
      None => self.status = f"이어진 세션 파일을 찾지 못했습니다: {next}",
    }
  }

  /// 열 때 시작 위치: 감시 중이고 최근 수정된 세션이면 맨 아래
  fn starts_at_bottom(self: Ref<Self>, s: model.Session) -> bool {
    if !self.opts.watch { return false }
    let info = match os.Stat(s.path) {
      Ok(i) => i,
      Err(_) => return false,
    }
    time.Since(info.ModTime()) < (LIVE_SECS as time.Duration) * time.Second
  }

  pub fn live_text(self: Ref<Self>) -> string {
    if !self.opts.watch { return "" }
    let mut parts = Slice.new<string>()
    if self.follow {
      parts = parts.append("● follow")
    } else {
      parts = parts.append("○ follow")
    }
    if self.new_count > 0 {
      parts = parts.append(f"새 메시지 {self.new_count} (G)")
    }
    parts.join(" ")
  }
}
