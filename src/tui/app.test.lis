import "go:github.com/charmbracelet/bubbletea"
import "go:github.com/soomtong/claude-code-history-viewer/shim"
import "go:os"
import "go:path/filepath"
import "go:time"

import "session"

const SID_A = "11111111-2222-4333-8444-555555555555"

const SID_B = "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"

fn fixture(name: string) -> string {
  let mut dir = os.Getwd().unwrap_or(".")
  for _ in 0..6 {
    let p = filepath.Join(dir, "fixtures", name)
    if let Ok(_) = os.Stat(p) { return p }
    dir = filepath.Dir(dir)
  }
  name
}

fn put(src: string, dst: string, age: time.Duration) {
  let data = os.ReadFile(fixture(src)).unwrap_or([])
  let _ = os.MkdirAll(filepath.Dir(dst), 0o755)
  let _ = os.WriteFile(dst, data, 0o644)
  let t = time.Now().Add(-age)
  let _ = os.Chtimes(dst, t, t)
}

/// 임시 projects 루트: /work/demo-app 에 세션 2개, /work/other 에 1개
fn make_root() -> string {
  let root = os.MkdirTemp("", "cci-tui-").unwrap_or("/nonexistent")
  let demo = filepath.Join(root, session.encode_path("/work/demo-app"))
  put("basic.jsonl", filepath.Join(demo, SID_A + ".jsonl"), time.Hour)
  put("untitled.jsonl", filepath.Join(demo, SID_B + ".jsonl"), 2 * time.Hour)
  put(
    "untitled.jsonl",
    filepath.Join(
      root,
      session.encode_path("/work/other"),
      "cccccccc-bbbb-4ccc-8ddd-eeeeeeeeeeee.jsonl",
    ),
    time.Minute,
  )
  root
}

fn opts(root: string) -> Options {
  Options {
    root,
    cwd: "/work/demo-app",
    scope: session.Scope.Cwd,
    theme: "dark",
    plain: true,
    ..,
  }
}

fn press(app: mut Ref<App>, keys: Slice<string>) {
  for k in keys {
    let _ = app.Update(shim.Key(k))
  }
}

#[test("목록: 현재 폴더 세션만, 최신순, 필터")]
fn list_and_filter() {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  let mut app = new_app(opts(root))
  let _ = app.Update(shim.WindowSize(100, 30))
  assert app.sessions.length() == 2
  let Some(first) = app.selected() else {
    assert false
    return
  }
  assert first.id == SID_A
  press(&app, ["/", "p", "i", "p", "e", "enter"])
  assert app.rows.length() == 1
  let Some(sel) = app.selected() else {
    assert false
    return
  }
  assert sel.id == SID_B
  press(&app, ["esc"])
  assert app.rows.length() == 2
  press(&app, ["a"])
  assert app.sessions.length() == 3
  assert app.View().contains("All projects")
}

#[test("대화: 열기, 메시지 점프, 뒤로")]
fn open_and_navigate() {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  let mut app = new_app(opts(root))
  let _ = app.Update(shim.WindowSize(80, 4))
  press(&app, ["enter"])
  assert app.screen == Screen.Conv
  // 기본 토글: 프롬프트 2 + 텍스트 있는 assistant 2
  assert app.spans.length() == 4
  assert app.View().contains("Add a greet function")
  press(&app, ["]"])
  assert app.vp.YOffset() == app.spans[1].start
  press(&app, ["}"])
  assert app.vp.YOffset() == app.spans[3].start
  press(&app, ["{"])
  assert app.vp.YOffset() == app.spans[0].start
  press(&app, ["h"])
  assert app.screen == Screen.List
  let Some(sel) = app.selected() else {
    assert false
    return
  }
  assert sel.id == SID_A
}

#[test("빈 범위 안내")]
fn empty_scope_hint() {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  let mut o = opts(root)
  o.cwd = "/work/nowhere"
  let mut app = new_app(o)
  assert app.sessions.length() == 0
  assert app.View().contains("--parent")
}

#[test("q 로 종료")]
fn quits() {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  let mut app = new_app(opts(root))
  let (_, cmd) = app.Update(shim.Key("q"))
  assert app.quitting
  assert cmd.is_some()
}

#[test("헤드리스 program: Send 로 키 주입")]
fn headless_program() -> Result<(), error> {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  let mut app = new_app(opts(root))
  let r = os.Open(os.DevNull)?
  let mut program = tea.NewProgram(
    &app,
    tea.WithInput(r),
    tea.WithoutRenderer(),
  )
  task {
    time.Sleep(30 * time.Millisecond)
    program.Send(shim.WindowSize(80, 20))
    program.Send(shim.Key("enter"))
    program.Send(shim.Key("G"))
    program.Send(shim.Key("q"))
  }
  let _ = program.Run()?
  assert app.screen == Screen.Conv
  assert app.quitting
  Ok(())
}

#[test("삭제 모달: 기본 취소, y 로 휴지통 이동, 열람 중 차단")]
fn delete_modal() {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  let old_home = os.Getenv("HOME")
  let _ = os.Setenv("HOME", root)
  defer {
    let _ = os.Setenv("HOME", old_home)
  }
  let real_root = filepath.EvalSymlinks(root).unwrap_or(root)
  let mut app = new_app(opts(real_root))
  let _ = app.Update(shim.WindowSize(120, 30))
  let Some(target) = app.selected() else {
    assert false
    return
  }
  press(&app, ["D"])
  assert app.modal.is_some()
  assert app.View().contains("Delete y | Cancel other keys")
  press(&app, ["enter"])
  assert app.modal.is_none()
  assert os.Stat(target.path).is_ok()
  press(&app, ["D", "n"])
  assert os.Stat(target.path).is_ok()
  // 열람 중이면 차단
  press(&app, ["enter", "h", "D"])
  assert app.View().contains("현재 열람 중")
  press(&app, ["y"])
  assert os.Stat(target.path).is_ok()
  // ctrl+r 로 열람 해제 후 삭제
  press(&app, ["ctrl+r", "D", "y"])
  assert os.Stat(target.path).is_err()
  assert app.sessions.length() == 1
  assert app.status.contains(".Trash")
}

#[test("대화 화면에서 D: 현재 세션 삭제 후 목록으로 복귀")]
fn delete_from_conv() {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  let old_home = os.Getenv("HOME")
  let _ = os.Setenv("HOME", root)
  defer {
    let _ = os.Setenv("HOME", old_home)
  }
  let real_root = filepath.EvalSymlinks(root).unwrap_or(root)
  let mut app = new_app(opts(real_root))
  let _ = app.Update(shim.WindowSize(120, 30))
  let Some(target) = app.selected() else {
    assert false
    return
  }
  // 취소하면 대화 화면에 남는다
  press(&app, ["enter", "D"])
  assert app.modal.is_some()
  assert !app.View().contains("현재 열람 중")
  press(&app, ["n"])
  assert app.screen == Screen.Conv
  assert os.Stat(target.path).is_ok()
  // y 로 삭제하면 목록으로 돌아간다
  press(&app, ["D", "y"])
  assert os.Stat(target.path).is_err()
  assert app.screen == Screen.List
  assert !app.has_conv
  assert app.sessions.length() == 1
}

#[test("R: 목록과 대화 화면에서 제목 변경, esc 취소, ctrl+r 새로고침")]
fn rename_title() {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  let real_root = filepath.EvalSymlinks(root).unwrap_or(root)
  let mut app = new_app(opts(real_root))
  let _ = app.Update(shim.WindowSize(100, 30))
  let Some(target) = app.selected() else {
    assert false
    return
  }
  // esc 는 취소, 파일 그대로
  let before = os.ReadFile(target.path).unwrap_or([]) as string
  press(&app, ["R"])
  assert app.renaming.is_some()
  assert app.View().contains("세션 제목 변경")
  press(&app, ["x", "esc"])
  assert app.renaming.is_none()
  assert (os.ReadFile(target.path).unwrap_or([]) as string) == before
  // 목록에서: 기존 제목을 지우고 새로 입력
  press(&app, ["R", "ctrl+u", "목록", " ", "제목", "enter"])
  assert app.renaming.is_none()
  let Some(sel) = app.selected() else {
    assert false
    return
  }
  assert sel.id == target.id
  assert sel.title == "목록 제목"
  assert app.View().contains("목록 제목")
  // 입력 중에는 단축키가 동작하지 않는다 (q 로 종료되지 않음)
  press(&app, ["enter", "R", "backspace", "backspace", "q", "enter"])
  assert !app.quitting
  assert app.current.title == "목록 q"
  assert app.View().contains("목록 q")
  // 새로고침은 ctrl+r
  press(&app, ["h", "ctrl+r"])
  assert app.status.contains("Refreshed")
}
