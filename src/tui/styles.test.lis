import "go:github.com/charmbracelet/lipgloss"
import "go:github.com/muesli/termenv"
import "go:github.com/soomtong/claude-code-history-viewer/shim"
import "go:os"

#[test("auto 테마만 배경 밝기에 따라 dark/light 로 바뀐다")]
fn theme_resolution() {
  assert resolve_theme("auto", true) == "dark"
  assert resolve_theme("auto", false) == "light"
  assert resolve_theme("dracula", false) == "dracula"
  assert resolve_theme("light", true) == "light"
}

#[test("창이 최소 크기보다 작으면 안내만 보이고 q 외 키는 무시")]
fn too_small() {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  let mut app = new_app(opts(root))
  let _ = app.Update(shim.WindowSize(MIN_WIDTH - 1, 10))
  assert app.View().contains("window too small")
  press(&app, ["D", "enter"])
  assert app.modal.is_none()
  assert app.screen == Screen.List
  // 다시 커지면 원래 화면
  let _ = app.Update(shim.WindowSize(80, 20))
  assert !app.View().contains("window too small")
  let _ = app.Update(shim.WindowSize(80, MIN_HEIGHT - 1))
  assert app.View().contains("window too small")
  press(&app, ["q"])
  assert app.quitting
}

#[test("glamour 도 lipgloss 색 프로필을 따른다 (색 없음이면 색 코드 없음)")]
fn markdown_follows_color_profile() {
  let root = make_root()
  defer {
    let _ = os.RemoveAll(root)
  }
  lipgloss.SetColorProfile(termenv.Ascii)
  let mut app = new_app(Options { plain: false, ..opts(root) })
  let _ = app.Update(shim.WindowSize(120, 200))
  press(&app, ["enter"])
  assert app.md_renders > 0
  assert !app.View().contains("[38;")
}
