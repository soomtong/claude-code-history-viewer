// 화면 스타일. 색은 밝은/어두운 배경용 한 쌍(AdaptiveColor)이고, 색 지원 수준은 lipgloss 가
// 터미널과 NO_COLOR/TERM=dumb 로 판단한다 (docs/decisions/0010).
// 색만으로 의미를 전하지 않는다: 역할/오류/diff 는 글자(› 프롬프트, ● 응답, ✗, +/-)로도 구분된다.
import "go:github.com/charmbracelet/lipgloss"
import "go:github.com/muesli/termenv"

/// 화면을 그릴 수 있는 최소 크기. 이보다 작으면 안내만 보여준다.
pub const MIN_WIDTH = 24

pub const MIN_HEIGHT = 3

/// light: 밝은 배경, dark: 어두운 배경에서 쓸 256색 번호
fn color(light: string, dark: string) -> lipgloss.AdaptiveColor {
  lipgloss.AdaptiveColor { Light: light, Dark: dark }
}

fn fg(light: string, dark: string) -> lipgloss.Style {
  lipgloss.NewStyle().Foreground(color(light, dark))
}

/// "auto" 테마를 실제 배경에 맞는 glamour 테마로 바꾼다. 나머지는 그대로.
pub fn resolve_theme(theme: string, dark_background: bool) -> string {
  if theme != "auto" { return theme }
  if dark_background { "dark" } else { "light" }
}

/// 프로그램 시작 전(Bubble Tea 가 입력을 잡기 전)에 한 번 호출한다.
/// 배경 밝기를 테마로 정하거나(auto 면 터미널에 질의해 캐시) 색을 끄고, glamour 에 넘길 테마를 돌려준다.
pub fn setup_colors(theme: string, no_color: bool) -> string {
  if no_color { lipgloss.SetColorProfile(termenv.Ascii) }
  match theme {
    "auto" => (),
    "light" => lipgloss.SetHasDarkBackground(false),
    _ => lipgloss.SetHasDarkBackground(true),
  }
  resolve_theme(theme, lipgloss.HasDarkBackground())
}

pub fn st_title() -> lipgloss.Style {
  fg("162", "212").Bold(true)
}

pub fn st_user() -> lipgloss.Style {
  fg("26", "39").Bold(true)
}

pub fn st_assistant() -> lipgloss.Style {
  fg("166", "208").Bold(true)
}

pub fn st_faint() -> lipgloss.Style {
  lipgloss.NewStyle().Faint(true)
}

pub fn st_thinking() -> lipgloss.Style {
  fg("243", "245").Italic(true)
}

pub fn st_tool() -> lipgloss.Style {
  fg("30", "109")
}

pub fn st_add() -> lipgloss.Style {
  fg("28", "42")
}

pub fn st_del() -> lipgloss.Style {
  fg("160", "203")
}

pub fn st_warn() -> lipgloss.Style {
  fg("130", "214").Bold(true)
}

pub fn st_error() -> lipgloss.Style {
  fg("160", "196").Bold(true)
}

pub fn st_status() -> lipgloss.Style {
  fg("235", "250").Background(color("254", "236"))
}

/// 상단 헤더 띠. 하단 상태줄과 같은 바탕.
pub fn st_bar() -> lipgloss.Style {
  st_status()
}

/// 헤더의 앱 배지. reverse 라 색이 꺼져도 띠에서 구분된다.
pub fn st_badge() -> lipgloss.Style {
  fg("162", "212").Bold(true).Reverse(true)
}

/// 목록에서 선택된 항목의 바탕 (표식 ┃ 와 굵은 제목이 함께 붙는다)
pub fn st_sel_row() -> lipgloss.Style {
  lipgloss.NewStyle().Background(color("253", "237"))
}

/// 사용자 프롬프트 블록의 바탕 (표식 › 가 함께 붙는다)
pub fn st_prompt() -> lipgloss.Style {
  lipgloss.NewStyle().Background(color("255", "235"))
}

/// 목록의 날짜 묶음 제목
pub fn st_group() -> lipgloss.Style {
  lipgloss.NewStyle().Faint(true).Bold(true)
}

/// base 바탕 위에 s 의 글자 스타일을 얹는다 (바탕이 끊기지 않게)
pub fn over(s: lipgloss.Style, base: lipgloss.Style) -> lipgloss.Style {
  s.Inherit(base)
}

pub fn st_modal() -> lipgloss.Style {
  lipgloss
    .NewStyle()
    .Border(lipgloss.RoundedBorder())
    .BorderForeground(color("160", "203"))
    .Padding(0, 1)
}

pub fn st_box() -> lipgloss.Style {
  lipgloss
    .NewStyle()
    .Border(lipgloss.RoundedBorder())
    .BorderForeground(color("26", "39"))
    .Padding(0, 1)
}

/// 직접 그리는 테두리(framed_box)의 선 색. st_box 테두리와 같다.
pub fn st_border() -> lipgloss.Style {
  fg("26", "39")
}
