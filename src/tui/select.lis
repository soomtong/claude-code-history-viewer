// 대화 본문 드래그 선택과 복사 (docs/decisions/0028).
// 위치는 화면 좌표가 아니라 viewport 내용의 (줄, 표시 열)로 기억한다. 그래서 휠이나 키로 스크롤해도
// 선택이 본문을 따라 움직인다. 다시 배치(relayout)하면 메시지 기준으로 줄을 옮기고, 옮길 수 없으면 지운다.
import "go:charm.land/bubbletea/v2"
import "go:github.com/atotto/clipboard"
import "go:github.com/charmbracelet/x/ansi"
import "go:strings"

/// 본문 안의 위치: 내용 줄 번호와 표시 열 (한글은 2열)
pub struct TextPos {
  pub line: int,
  pub col: int,
}

/// 드래그 선택. anchor 는 누른 곳, head 는 지금 끝. 두 끝 모두 포함한다.
pub struct Selection {
  pub anchor: TextPos,
  pub head: TextPos,
  pub dragging: bool, // 버튼을 누르고 있는 중
  pub moved: bool, // 누른 뒤 끝이 한 번이라도 움직였는지 (아니면 클릭으로 보고 지운다)
}

fn same_pos(a: TextPos, b: TextPos) -> bool {
  a.line == b.line && a.col == b.col
}

/// 앞 끝과 뒤 끝 순서로
fn ordered(s: Selection) -> (TextPos, TextPos) {
  let a = s.anchor
  let h = s.head
  if a.line < h.line || (a.line == h.line && a.col <= h.col) {
    (a, h)
  } else {
    (h, a)
  }
}

/// 줄 끝 공백을 뺀 글자의 표시 폭 (glamour 는 줄을 공백으로 채운다)
fn text_width(plain: string) -> int {
  ansi.StringWidth(strings.TrimRight(plain, " "))
}

/// line 줄에서 선택된 열 범위 [a, b). 줄의 글자 폭(text_w)을 넘지 않는다. 고를 것이 없으면 None.
pub fn sel_cols(s: Selection, line: int, text_w: int) -> Option<(int, int)> {
  let (lo, hi) = ordered(s)
  if line < lo.line || line > hi.line { return None }
  let a = if line == lo.line { lo.col } else { 0 }
  let b0 = if line == hi.line { hi.col + 1 } else { text_w }
  let b = min(b0, text_w)
  if b <= a { return None }
  Some((a, b))
}

/// 화면에 보이는 한 줄 r(내용 line 줄)에 선택 영역을 반전으로 입힌다.
/// 앞뒤 조각의 색은 그대로 두고(ansi.Cut 이 escape 를 보존한다), 가운데는 글자만 남겨 반전한다.
pub fn highlight_row(r: string, s: Selection, line: int) -> string {
  let Some((a, b)) = sel_cols(s, line, text_width(ansi.Strip(r))) else {
    return r
  }
  let w = ansi.StringWidth(r)
  ansi.Cut(r, 0, a) + ansi.ResetStyle +
  st_select().Render(ansi.Strip(ansi.Cut(r, a, b))) +
  ansi.Cut(r, b, w)
}

/// 내용(content)에서 선택 영역의 글자. ANSI 와 줄 끝 공백은 지운다. 공백뿐이면 "".
pub fn selected_text(content: string, s: Selection) -> string {
  let lines = content.split("\n")
  let (lo, hi) = ordered(s)
  let mut out = Slice.new<string>()
  let end = min(hi.line + 1, lines.length())
  for l in max(lo.line, 0)..end {
    let plain = ansi.Strip(lines[l])
    let piece = match sel_cols(s, l, text_width(plain)) {
      Some((a, b)) => strings.TrimRight(ansi.Cut(plain, a, b), " "),
      None => "",
    }
    out = out.append(piece)
  }
  let text = out.join("\n")
  if strings.TrimSpace(text) == "" { "" } else { text }
}

/// 다시 배치한 뒤 위치 p 를 옮긴다. p 가 속한 메시지가 사라졌거나 줄 수가 바뀌었으면 None.
fn remap_pos(old: Slice<Span>, new: Slice<Span>, p: TextPos) -> Option<TextPos> {
  let Some(o) = old.get(span_index(old, p.line)) else {
    return None
  }
  let Some(n) = new.find(|s| s.msg == o.msg) else {
    return None
  }
  if n.lines != o.lines { return None }
  Some(TextPos { line: n.start + p.line - o.start, col: p.col })
}

/// 선택의 두 끝을 새 배치로 옮긴다. 한 끝이라도 못 옮기면 선택을 지운다.
pub fn remap_selection(
  old: Slice<Span>,
  new: Slice<Span>,
  sel: Option<Selection>,
) -> Option<Selection> {
  let Some(s) = sel else {
    return None
  }
  let Some(anchor) = remap_pos(old, new, s.anchor) else {
    return None
  }
  let Some(head) = remap_pos(old, new, s.head) else {
    return None
  }
  Some(Selection { anchor, head, ..s })
}

impl App {
  /// 지금 선택. 대화가 없거나 선택이 없으면 None.
  pub fn selection(self: Ref<Self>) -> Option<Selection> {
    self.open.and_then(|c| c.sel)
  }

  pub fn clear_selection(self: mut Ref<Self>) {
    if let Some(c) = self.open { c.sel = None }
  }

  /// 대화 본문의 첫 화면 줄(y). 헤더를 접으면 0.
  fn body_top(self: Ref<Self>) -> int {
    self.conv_header_rows()
  }

  /// 화면 좌표를 본문 위치로. y 는 본문 범위 안으로, x 는 왼쪽 여백 1열을 빼고 본문 폭 안으로 맞춘다.
  fn body_pos(self: Ref<Self>, x: int, y: int) -> TextPos {
    let row = min(max(y - self.body_top(), 0), self.vp_height() - 1)
    let last = max(self.vp.TotalLineCount() - 1, 0)
    let line = min(self.vp.YOffset() + row, last)
    let col = min(max(x - 1, 0), self.content_width() - 1)
    TextPos { line, col }
  }

  /// 왼쪽 버튼을 누름: 본문 안이면 새 선택을 시작한다 (전에 있던 선택은 버린다).
  pub fn start_select(self: mut Ref<Self>, x: int, y: int) {
    let top = self.body_top()
    if y < top || y >= top + self.vp_height() { return }
    let p = self.body_pos(x, y)
    let Some(c) = self.open else {
      return
    }
    c.sel = Some(Selection { anchor: p, head: p, dragging: true, moved: false })
  }

  /// 누른 채 끌기: 끝을 옮긴다. 본문 위나 아래로 벗어나면 그쪽으로 한 줄 스크롤한다.
  pub fn on_drag(self: mut Ref<Self>, m: tea.MouseMotionMsg) {
    if self.too_small() || self.screen != Screen.Conv { return }
    let normal = match self.mode {
      Mode.Normal => true,
      _ => false,
    }
    if !normal { return }
    let Some(s) = self.selection() else {
      return
    }
    if !s.dragging { return }
    let top = self.body_top()
    if m.Y < top {
      self.scroll_conv(-1)
    } else if m.Y >= top + self.vp_height() { self.scroll_conv(1) }
    // 스크롤이 다시 배치하면서 선택을 지웠을 수 있다
    let Some(cur) = self.selection() else {
      return
    }
    let head = self.body_pos(m.X, m.Y)
    let moved = cur.moved || !same_pos(head, cur.anchor)
    if let Some(c) = self.open {
      c.sel = Some(Selection { head, moved, ..cur })
    }
  }

  /// 버튼을 놓음: 선택을 확정한다. 움직이지 않았으면(그냥 클릭) 선택을 지운다.
  pub fn on_release(self: mut Ref<Self>) {
    let Some(s) = self.selection() else {
      return
    }
    if !s.dragging { return }
    let Some(c) = self.open else {
      return
    }
    c.sel = if s.moved {
      Some(Selection { dragging: false, ..s })
    } else {
      None
    }
  }

  /// 선택된 글자. 선택이 없으면 "".
  pub fn selection_text(self: Ref<Self>) -> string {
    let Some(c) = self.open else {
      return ""
    }
    let Some(s) = c.sel else {
      return ""
    }
    selected_text(c.content, s)
  }

  /// y: 선택 영역을 클립보드에 담고 선택을 지운다. 시스템 클립보드를 못 쓰면(SSH 등) OSC 52 로 보낸다.
  fn copy_selection(self: mut Ref<Self>) -> Option<tea.Cmd> {
    let text = self.selection_text()
    if text == "" {
      self.notify("Nothing selected (drag over the text first)")
      return None
    }
    self.clear_selection()
    let n = line_count(text)
    let unit = if n == 1 { "line" } else { "lines" }
    match clipboard.WriteAll(text) {
      Ok(_) => {
        self.notify(f"Copied {n} {unit}")
        None
      },
      Err(_) => {
        self.notify(f"Copied {n} {unit} (OSC 52)")
        Some(tea.SetClipboard(text))
      },
    }
  }
}
