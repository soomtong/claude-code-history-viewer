// 세션 목록 화면: 상태 갱신(읽기, 필터, 커서), 줄 배치(날짜 묶음), 키, 그리기.
import "go:charm.land/bubbletea/v2"
import "go:charm.land/lipgloss/v2"
import "go:github.com/charmbracelet/x/ansi"
import "go:strings"
import "go:time"

import "model"
import "session"

/// 화면 밖(Init 의 Cmd)에서 읽어 온 세션 목록. generation 이 최신일 때만 받는다.
struct SessionsLoaded {
  generation: int,
  dirs: Slice<string>,
  sessions: Slice<model.Session>,
}

/// 목록 화면의 한 줄: 묶음 사이 빈 줄, 묶음 제목, 세션 항목의 몇 번째 줄
pub enum ListLine {
  Gap,
  Group(string),
  Item { row: int, part: int },
}

/// 목록 줄 배치. rows 의 i 번째 세션 시각이 times[i].
pub fn list_lines(
  times: Slice<string>,
  per_item: int,
  now: time.Time,
) -> Slice<ListLine> {
  let mut out = Slice.new<ListLine>()
  let mut prev = ""
  for (i, ts) in times.enumerate() {
    let label = group_label(ts, now)
    if i == 0 || label != prev {
      if i > 0 { out = out.append(ListLine.Gap) }
      out = out.append(ListLine.Group(label))
      prev = label
    }
    for part in 0..per_item {
      out = out.append(ListLine.Item { row: i, part })
    }
  }
  out
}

/// row 번째 항목의 (첫 줄, 마지막 줄). 바로 위가 묶음 제목이면 첫 줄을 제목으로 잡는다.
pub fn item_bounds(lines: Slice<ListLine>, row: int) -> (int, int) {
  let mut first = -1
  let mut last = -1
  for (i, l) in lines.enumerate() {
    if let ListLine.Item { row: r, .. } = l {
      if r == row {
        if first < 0 { first = i }
        last = i
      }
    }
  }
  if first > 0 { if let ListLine.Group(_) = lines[first - 1] { first -= 1 } }
  (first, last)
}

/// 목록의 날짜 묶음: 오늘, 어제, 최근 7일, 그 이전은 월 단위
pub fn group_label(ts: string, now: time.Time) -> string {
  let Some(t) = parse_local(ts) else {
    return "날짜 없음"
  }
  let day = t.Format("2006-01-02")
  if day == now.Format("2006-01-02") { return "오늘" }
  if day == now.AddDate(0, 0, -1).Format("2006-01-02") { return "어제" }
  if now.Sub(t) < (7 * 24 as time.Duration) * time.Hour { return "최근 7일" }
  t.Format("2006년 1월")
}

/// 목록의 날짜 묶음 제목. 줄 끝까지 흐린 선을 그어 묶음 경계를 보인다.
/// 오른쪽 1칸은 항목 시각 뒤 여백과 맞춘다.
pub fn group_header(label: string, width: int) -> string {
  let rule = max(width - ansi.StringWidth(label) - 4, 0)
  st_group().Render("  " + label) +
  st_faint().Render(" " + strings.Repeat("─", rule))
}

pub fn scope_label(scope: session.Scope) -> string {
  match scope {
    session.Scope.Cwd => "Current folder",
    session.Scope.Parent => "Parent and children",
    session.Scope.All => "All projects",
  }
}

/// 목록 필터: 제목, 첫 프롬프트, cwd, gitBranch, 날짜, id 부분일치 (q 는 소문자)
pub fn matches_session(s: model.Session, q: string) -> bool {
  let hay = [
      s.title,
      s.first_prompt,
      s.cwd,
      s.git_branch,
      fmt_time(s.updated, true),
      fmt_time(s.started, true),
      fmt_time(list_time(s), true),
      s.id,
    ].join(
    "\n",
  )
  strings.ToLower(hay).contains(q)
}

/// 목록 항목 둘째 줄: 브랜치, 메시지/프롬프트 수, (전체 범위면) 폴더
pub fn session_meta(s: model.Session, all_mode: bool) -> string {
  let mut parts = Slice.new<string>()
  if s.git_branch != "" { parts = parts.append(s.git_branch) }
  parts = parts.append(f"메시지 {s.msg_count}")
  parts = parts.append(f"프롬프트 {s.prompt_count}")
  if all_mode && s.cwd != "" { parts = parts.append(s.cwd) }
  parts.join(" · ")
}

/// 목록의 정렬 기준(파일 수정 시각)을 RFC3339 로. 묶음과 표시 시각을 정렬과 맞춘다.
/// 제목 변경처럼 메시지 없이 파일만 바뀌어도 순서와 묶음이 어긋나지 않는다.
pub fn list_time(s: model.Session) -> string {
  if s.mtime <= 0 { return s.updated }
  time.Unix(s.mtime, 0).Format(time.RFC3339)
}

impl App {
  fn on_filter_key(
    self: mut Ref<Self>,
    key: tea.KeyPressMsg,
    k: string,
  ) -> Option<tea.Cmd> {
    match k {
      "esc" => {
        self.filter = ""
        self.mode = Mode.Normal
      },
      "enter" => self.mode = Mode.Normal,
      _ => return Some(self.feed_input(key)),
    }
    self.apply_filter()
    None
  }

  fn on_list_key(self: mut Ref<Self>, k: string) -> Option<tea.Cmd> {
    if let Some(n) = nav_of(k) {
      self.move_cursor(nav_delta(n, self.list_page(), self.rows.length()))
      return None
    }
    match k {
      "q" => return self.quit(),
      "?" => self.mode = Mode.Help { top: 0 },
      "enter" | "l" | "right" => {
        if let Some(s) = self.selected() { self.open_session(s) }
      },
      "/" => {
        self.mode = Mode.Filter
        self.start_input(self.filter)
      },
      "esc" => {
        self.filter = ""
        self.apply_filter()
      },
      "D" => {
        if let Some(s) = self.selected() { self.ask_delete(s, false) }
      },
      "R" => {
        if let Some(s) = self.selected() { self.ask_rename(s) }
      },
      "ctrl+r" => {
        // 새로고침은 열람 중 표시도 해제한다
        self.open = None
        self.reload_list()
        self.notify(f"Refreshed: {self.sessions.length()} sessions")
      },
      "a" => self.toggle_scope(),
      "y" => {
        if let Some(s) = self.selected() { self.copy_resume(s.id) }
      },
      _ => (),
    }
    None
  }

  /// 목록 줄 수: 헤더, 필터 줄, 하단 줄을 뺀다
  pub fn list_height(self: Ref<Self>) -> int {
    max(self.height - LIST_HEADER_ROWS - FOOTER_ROWS, 1)
  }

  /// 세션 항목 하나의 줄 수: 제목 + 메타 줄, 좁으면 제목만
  fn list_per_item(self: Ref<Self>) -> int {
    if self.narrow() { 1 } else { 2 }
  }

  /// 페이지 이동 단위(항목 수)
  fn list_page(self: Ref<Self>) -> int {
    max(self.list_height() / self.list_per_item(), 1)
  }

  /// 현재 필터 결과의 목록 줄 배치 (날짜 묶음 포함). clamp_list 가 갱신해 둔 것을 읽는다.
  fn list_layout(self: Ref<Self>) -> Slice<ListLine> {
    self.layout
  }

  /// 배치를 다시 만든다. rows 가 바뀌면 apply_filter 가 키를 비우고,
  /// 항목 줄 수(폭)나 날짜가 바뀌면 키가 달라진다. 그대로면 아무것도 하지 않는다.
  fn refresh_layout(self: mut Ref<Self>) {
    let now = time.Now()
    let day = now.Format("2006-01-02")
    let key = f"{self.list_per_item()}|{day}"
    if key == self.layout_key { return }
    let times = self.rows.map(|r| list_time(self.sessions[r]))
    self.layout = list_lines(times, self.list_per_item(), now)
    self.layout_key = key
  }

  /// 목록을 지금 다시 읽는다 (새로고침, 범위 전환). 읽는 중이던 결과는 버린다.
  pub fn reload_list(self: mut Ref<Self>) {
    self.list_gen += 1
    let dirs = session.project_dirs(self.opts.root, self.opts.cwd, self.scope)
    self.set_sessions(dirs, session.list_sessions(dirs))
  }

  fn set_sessions(
    self: mut Ref<Self>,
    dirs: Slice<string>,
    sessions: mut Slice<model.Session>,
  ) {
    let keep = self.selected().map_or("", |s| s.id)
    self.sessions = sessions
    self.dirs = dirs
    self.loading = false
    self.apply_filter()
    self.select_id(keep)
    self.notify_dirs()
  }

  fn toggle_scope(self: mut Ref<Self>) {
    self.scope = match self.scope {
      session.Scope.All => self.opts.scope,
      _ => session.Scope.All,
    }
    if self.scope == session.Scope.All && self.opts.scope == session.Scope.All {
      self.scope = session.Scope.Cwd
    }
    self.reload_list()
    self.notify(f"Scope: {scope_label(self.scope)}")
  }

  pub fn apply_filter(self: mut Ref<Self>) {
    let q = strings.ToLower(strings.TrimSpace(self.filter))
    let mut rows = Slice.new<int>()
    for (i, s) in self.sessions.enumerate() {
      if q == "" || matches_session(s, q) { rows = rows.append(i) }
    }
    self.rows = rows
    self.layout_key = ""
    self.clamp_list()
  }

  fn select_id(self: mut Ref<Self>, id: string) {
    if id == "" { return }
    for (i, r) in self.rows.enumerate() {
      if self.sessions[r].id == id {
        self.cursor = i
        self.clamp_list()
        return
      }
    }
  }

  /// 커서를 범위 안으로, top(줄 단위)을 선택 항목이 다 보이게 맞춘다.
  /// 항목이 묶음의 첫 항목이면 묶음 제목도 함께 보이게 한다.
  fn clamp_list(self: mut Ref<Self>) {
    let n = self.rows.length()
    if self.cursor >= n { self.cursor = n - 1 }
    if self.cursor < 0 { self.cursor = 0 }
    let h = self.list_height()
    self.refresh_layout()
    let layout = self.list_layout()
    let (first, last) = item_bounds(layout, self.cursor)
    if first >= 0 {
      if last >= self.top + h { self.top = last - h + 1 }
      if first < self.top { self.top = first }
      // 창이 항목보다 낮으면 제목 줄을 우선한다
      if last - first + 1 > h { self.top = last - self.list_per_item() + 1 }
    }
    self.top = min(self.top, max(layout.length() - h, 0))
    if self.top < 0 { self.top = 0 }
  }

  fn move_cursor(self: mut Ref<Self>, delta: int) {
    self.cursor += delta
    self.clamp_list()
  }

  pub fn selected(self: Ref<Self>) -> Option<model.Session> {
    let r = self.rows.get(self.cursor)?
    self.sessions.get(r)
  }

  fn view_list(self: Ref<Self>) -> string {
    let mut lines = Slice.new<string>()
    let total = self.sessions.length()
    let shown = self.rows.length()
    let count = if shown == total {
      f"{total} sessions"
    } else {
      f"{shown}/{total} sessions"
    }
    let base = st_bar()
    // 현재 폴더 범위는 라벨 대신 기호만 둔다 (0018)
    let scope = if self.scope == session.Scope.Cwd {
      base.Render(CWD_MARK + " ")
    } else {
      base.Render(scope_label(self.scope)) +
      over(st_faint(), base).Render(" › ")
    }
    let crumbs = scope +
    over(lipgloss.NewStyle().Bold(true), base).Render(self.opts.cwd)
    lines = lines.append(header_bar(
      self.opts.version,
      crumbs,
      count,
      self.width,
    ))
    if self.filter_editing() {
      lines = lines.append(" / " + self.input_line(self.filter, self.width - 4))
    } else if self.filter != "" {
      lines = lines.append(clip(f" / {self.filter}", self.width - 1))
    } else {
      lines = lines.append("")
    }
    let h = self.list_height()
    let mut body = Slice.new<string>()
    if shown == 0 { body = body.append(self.empty_hint()...) }
    let layout = self.list_layout()
    let all_mode = self.scope != session.Scope.Cwd
    let now = time.Now()
    for k in self.top..min(self.top + h, layout.length()) {
      body = body.append(self.list_line(layout[k], all_mode, now))
    }
    while body.length() < h {
      body = body.append("")
    }
    // 본문은 정확히 h 줄: 빈 목록 안내가 길어도 하단 줄을 밀어내지 않는다
    lines = lines.append(body[..h]...)
    let hints = if self.filter_editing() {
      [[hint("Confirm", "↵"), hint("Cancel", "esc")]]
    } else {
      [
        [hint("Open", "↵"), hint("Filter", "/"), hint("Scope", "a")],
        [
          label("Session"),
          hint("rename", "R"),
          hint("delete", "D"),
          hint("resume", "y"),
          hint("refresh", "^r"),
        ],
        [hint("Help", "?"), hint("Quit", "q")],
      ]
    }
    let pos = if shown == 0 { "" } else { f"{self.cursor + 1}/{shown}" }
    lines = lines.append(footer(self.status, "", hints, pos, self.width))
    lines.join("\n")
  }

  /// 목록 한 줄. 선택 항목은 ┃ 표식, 굵은 제목, 옅은 바탕.
  fn list_line(
    self: Ref<Self>,
    l: ListLine,
    all_mode: bool,
    now: time.Time,
  ) -> string {
    match l {
      ListLine.Gap => "",
      ListLine.Group(label) => group_header(label, self.width),
      ListLine.Item { row, part } => {
        let s = self.sessions[self.rows[row]]
        let sel = row == self.cursor
        let base = if sel { st_sel_row() } else { lipgloss.NewStyle() }
        let lead = if sel {
          over(st_user(), base).Render("┃") + base.Render(" ")
        } else {
          base.Render("  ")
        }
        if part == 0 {
          let title = strings.ReplaceAll(s.title, "\t", " ")
          let st = if sel {
            over(lipgloss.NewStyle().Bold(true), base)
          } else {
            base
          }
          let right = over(st_faint(), base).Render(
            short_time(list_time(s), now) + " ",
          )
          fit(lead + st.Render(title), right, self.width, base)
        } else {
          let meta = over(st_faint(), base).Render(session_meta(s, all_mode))
          fit(lead + meta, "", self.width, base)
        }
      },
    }
  }

  fn empty_hint(self: Ref<Self>) -> Slice<string> {
    if self.loading { return ["", st_faint().Render("  Loading sessions…")] }
    if self.filter != "" {
      return [
        "",
        st_faint().Render("  필터와 일치하는 세션이 없습니다"),
        st_faint().Render("  Clear filter esc"),
      ]
    }
    match self.scope {
      session.Scope.Cwd => [
        "",
        st_warn().Render("  현재 폴더에 해당하는 Claude Code 세션이 없습니다."),
        st_faint().Render(
          f"  찾은 위치: {self.opts.root}/{session.encode_path(self.opts.cwd)}",
        ),
        st_faint().Render(
          "  All projects a | cci --all, or --parent from a worktree",
        ),
      ],
      _ => ["", st_warn().Render(f"  세션이 없습니다: {self.opts.root}")],
    }
  }
}
