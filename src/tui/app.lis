// Bubble Tea 모델. 화면: 세션 목록, 대화 뷰, 도움말, 삭제 확인 모달.
import "go:charm.land/bubbletea/v2"
import "go:charm.land/glamour/v2"
import "go:github.com/atotto/clipboard"
import "go:github.com/soomtong/claude-code-history-viewer/shim"
import "go:time"

import "model"
import "session"

pub struct Options {
  pub root: string,
  pub cwd: string,
  pub scope: session.Scope,
  pub watch: bool,
  pub purge: bool,
  pub theme: string,
  pub compact: bool,
  pub open_path: string, // 바로 열 세션 경로 ("" 이면 목록부터)
  pub plain: bool, // 테스트에서 glamour 를 끄고 평문 렌더만 쓰기
  pub version: string, // 헤더에 보일 앱 버전 ("" 이면 생략)
  pub mouse: bool, // 마우스 휠, 클릭을 받는다 (0024)
  pub defer_list: bool, // 목록을 화면이 뜬 뒤에 읽는다 (main 이 켠다. 끄면 new_app 이 바로 읽는다)
}

pub enum Screen {
  #[default]
  List,
  Conv,
}

/// 리사이즈 디바운스 완료
struct ResizeDone { generation: int }

/// 상태 메시지를 보여 주는 시간(초). 지나면 하단 줄이 키 힌트로 돌아간다 (0015).
pub const STATUS_TTL_SECS = 4

/// 상태 메시지 만료. generation 이 최신일 때만 지운다 (그 사이 새 메시지가 떴으면 무시).
struct StatusExpired { generation: int }

pub struct App {
  pub opts: Options,
  pub screen: Screen,
  pub width: int,
  pub height: int,
  pub mode: Mode,
  pub status: string,
  status_gen: int, // notify 할 때마다 증가 (만료 타이머 구분)
  pub quitting: bool,
  // 목록
  pub scope: session.Scope,
  pub sessions: mut Slice<model.Session>,
  pub rows: mut Slice<int>,
  pub cursor: int,
  top: int,
  layout: Slice<ListLine>, // rows 의 줄 배치 (clamp_list 가 갱신한다)
  layout_key: string, // layout 을 만든 조건 (항목 줄 수, 날짜). 비면 다시 만든다
  pub loading: bool, // 첫 목록을 읽는 중
  list_gen: int, // 목록을 다시 읽을 때마다 증가 (늦게 도착한 결과 구분)
  pub filter: string,
  // 대화: 열어 둔 세션의 상태(open)와, 세션이 바뀌어도 유지되는 보기 설정
  pub open: Option<mut Ref<ConvView>>,
  vp: mut Ref<shim.Viewport>,
  pub toggles: Toggles,
  pub role: RoleFilter,
  md: Option<Ref<glamour.TermRenderer>>,
  md_width: int,
  resize_gen: int,
  cache: mut Map<string, string>, // 렌더 캐시 (키: cache_key)
  pub md_renders: int, // glamour 렌더 횟수 (지연 렌더 검증용)
  trash_root: string,
  // 한 줄 입력의 편집 엔진 (제목, 필터, 검색이 함께 쓴다)
  input: mut Ref<shim.TextInput>,
  // 모니터링
  pub dirs: Slice<string>,
  watch_hook: Option<fn(Slice<string>)>,
}

pub fn new_app(opts: Options) -> mut App {
  // 구조체 리터럴 안에서 Result.unwrap_or 를 쓰면 lis 0.12.4 가 다른 필드의 임시변수를 누락한다 (0005 참고)
  let trash_root = session.default_trash_root().unwrap_or("")
  let mut app = App {
    opts,
    screen: Screen.List,
    mode: Mode.Normal,
    width: 80,
    height: 24,
    scope: opts.scope,
    sessions: [],
    rows: [],
    open: None,
    vp: shim.NewViewport(80, 22),
    input: shim.NewTextInput(),
    toggles: Toggles { .. },
    role: RoleFilter.All,
    cache: Map.new<string, string>(),
    trash_root,
    dirs: [],
    ..,
  }
  if opts.open_path != "" {
    app.open_path(opts.open_path)
  } else if opts.defer_list { app.loading = true } else { app.reload_list() }
  app
}

impl App {
  #[allow(non_snake_case_function)]
  pub fn Init(self: mut Ref<Self>) -> Option<tea.Cmd> {
    if !self.loading { return None }
    // 세션이 많으면(--all) 읽는 데 시간이 걸린다. 화면을 먼저 띄우고 Cmd 로 읽는다.
    let root = self.opts.root
    let cwd = self.opts.cwd
    let scope = self.scope
    let generation = self.list_gen
    Some(|| {
      let dirs = session.project_dirs(root, cwd, scope)
      SessionsLoaded { generation, dirs, sessions: session.list_sessions(dirs) }
    })
  }

  #[allow(non_snake_case_function)]
  pub fn Update(
    self: mut Ref<Self>,
    msg: tea.Msg,
  ) -> (tea.Model, Option<tea.Cmd>) {
    if let Some(e) = assert_type<StatusExpired>(msg) {
      if e.generation == self.status_gen { self.status = "" }
      return (self, None)
    }
    let before = self.status_gen
    let cmd = self.dispatch(msg)
    // notify 가 불렸을 때만 만료 타이머를 건다 (같은 글이어도 다시 건다)
    if self.status_gen == before || self.status == "" { return (self, cmd) }
    let generation = self.status_gen
    let ttl = (STATUS_TTL_SECS as time.Duration) * time.Second
    let expire = tea.Tick(ttl, |_| StatusExpired { generation })
    let next = match cmd {
      Some(c) => tea.Batch(c, expire),
      None => Some(expire),
    }
    (self, next)
  }

  /// 하단 줄에 상태 메시지를 띄운다. 잠시 뒤(STATUS_TTL_SECS) 사라진다.
  /// 지울 때만 status 에 "" 를 직접 넣고, 띄울 때는 항상 이 함수를 쓴다 (타이머가 여기서 갈린다).
  pub fn notify(self: mut Ref<Self>, text: string) {
    self.status = text
    self.status_gen += 1
  }

  fn dispatch(self: mut Ref<Self>, msg: tea.Msg) -> Option<tea.Cmd> {
    if let Some(size) = assert_type<tea.WindowSizeMsg>(msg) {
      return self.on_resize(size.Width, size.Height)
    }
    if let Some(done) = assert_type<ResizeDone>(msg) {
      if done.generation == self.resize_gen { self.relayout() }
      return None
    }
    if let Some(key) = assert_type<tea.KeyPressMsg>(msg) {
      return self.on_key(key)
    }
    if let Some(l) = assert_type<SessionsLoaded>(msg) {
      if self.loading && l.generation == self.list_gen {
        self.set_sessions(l.dirs, l.sessions.clone())
      }
      return None
    }
    if let Some(changed) = assert_type<FilesChanged>(msg) {
      self.on_files(changed.paths)
      return None
    }
    // 마우스는 입력창이 열려 있어도 입력으로 넘기지 않는다. 휠과 클릭만 쓰고 나머지는 버린다.
    // 마우스를 껐으면(--no-mouse) 혹시 들어온 이벤트도 버린다 (0024).
    if assert_type<tea.MouseMsg>(msg).is_some() {
      if !self.opts.mouse { return None }
      if let Some(m) = assert_type<tea.MouseWheelMsg>(msg) { self.on_wheel(m) }
      if let Some(m) = assert_type<tea.MouseClickMsg>(msg) { self.on_click(m) }
      return None
    }
    // 붙여넣기는 키가 아니라(v2) 입력창이 열려 있고 화면이 보일 때만 넣는다 (0021)
    if assert_type<tea.PasteMsg>(msg).is_some() {
      self.status = ""
      if self.too_small() || !self.editing() { return None }
      return Some(self.feed_input(msg))
    }
    if self.editing() { return Some(self.feed_input(msg)) }
    // 본문 스크롤은 키(on_conv_key)와 마우스(on_wheel)가 직접 하므로 viewport 에 넘길 메시지가 없다
    None
  }

  /// 화면 전체를 대체 화면(alt screen)에 그린다. 내용은 `frame`.
  #[allow(non_snake_case_function)]
  pub fn View(self: mut Ref<Self>) -> tea.View {
    let mut v = tea.NewView(self.frame())
    v.AltScreen = true
    // 셀 단위 모드: 클릭, 놓기, 휠, 누른 채 끌기만 받는다 (움직임만으로는 이벤트가 오지 않는다)
    if self.opts.mouse { v.MouseMode = tea.MouseModeCellMotion }
    v
  }

  /// 지금 화면의 문자열. 테스트는 이것을 본다.
  pub fn frame(self: mut Ref<Self>) -> string {
    if self.quitting { return "" }
    if self.too_small() { return self.view_too_small() }
    let modal = match self.mode {
      Mode.Help { top } => self.view_help(top),
      Mode.ConfirmDelete(plan) => self.view_modal(plan),
      Mode.Rename(r) => self.view_rename(r),
      Mode.Normal | Mode.Filter | Mode.Search => "",
    }
    let screen = match self.screen {
      Screen.List => self.view_list(),
      Screen.Conv => self.view_conv(),
    }
    if modal == "" { return screen }
    overlay(screen, modal, self.width, self.height)
  }

  fn on_resize(self: mut Ref<Self>, w: int, h: int) -> Option<tea.Cmd> {
    let first = self.width == 80 && self.height == 24 && self.resize_gen == 0
    self.width = w
    self.height = h
    self.vp.SetSize(self.content_width(), self.vp_height())
    self.clamp_list()
    self.resize_gen += 1
    if first || !self.has_conv() {
      self.relayout()
      return None
    }
    // 연속 리사이즈는 마지막 것만 다시 렌더한다
    let generation = self.resize_gen
    Some(tea.Tick(150 * time.Millisecond, |_| ResizeDone { generation }))
  }

  /// 창이 최소 크기보다 작아 안내만 보이는 상태
  fn too_small(self: Ref<Self>) -> bool {
    self.width < MIN_WIDTH || self.height < MIN_HEIGHT
  }

  /// 간결한 배치: 목록 항목은 한 줄, 메시지 시각은 생략. --compact 이거나 폭이 좁을 때.
  /// (대화 헤더를 접는 조건은 conv_header_rows 가 따로 정한다)
  fn narrow(self: Ref<Self>) -> bool {
    self.opts.compact || self.width < 60
  }

  /// Bubble Tea v2 는 연타해도 글자마다 키 이벤트를 따로 보낸다 (0019, 0021).
  pub fn on_key(self: mut Ref<Self>, key: tea.KeyPressMsg) -> Option<tea.Cmd> {
    let k = key.String()
    self.status = ""
    if k == "ctrl+c" { return self.quit() }
    // 화면이 안 보이는 동안 삭제 모달 같은 동작이 몰래 일어나지 않게 종료만 받는다
    if self.too_small() {
      if k == "q" { return self.quit() }
      return None
    }
    match self.mode {
      Mode.Help { top } => {
        self.on_help_key(top, k)
        None
      },
      Mode.ConfirmDelete(plan) => {
        self.on_modal_key(plan, k)
        None
      },
      Mode.Rename(r) => self.on_rename_key(r, key, k),
      Mode.Filter => self.on_filter_key(key, k),
      Mode.Search => self.on_search_key(key, k),
      Mode.Normal => match self.screen {
        Screen.List => self.on_list_key(k),
        Screen.Conv => self.on_conv_key(k),
      },
    }
  }

  fn quit(self: mut Ref<Self>) -> Option<tea.Cmd> {
    self.quitting = true
    Some(tea.Quit)
  }

  fn copy_resume(self: mut Ref<Self>, id: string) {
    if id == "" { return }
    let cmd = f"claude --resume {id}"
    let text = match clipboard.WriteAll(cmd) {
      Ok(_) => f"Copied: {cmd}",
      Err(_) => f"{cmd}  (clipboard unavailable)",
    }
    self.notify(text)
  }

  /// 창이 최소 크기보다 작을 때. 폭이 좁아도 잘리지 않게 짧은 줄로 나눈다.
  fn view_too_small(self: Ref<Self>) -> string {
    let lines = [
      "Window too small",
      f"{self.width}x{self.height}",
      f"Min {MIN_WIDTH}x{MIN_HEIGHT}",
      "Quit q",
    ]
    lines[..min(lines.length(), max(self.height, 1))].join("\n")
  }
}
