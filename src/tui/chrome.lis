// 화면 틀: 상단 헤더 띠, 하단 키 힌트 줄, 목록의 날짜 묶음 (docs/decisions/0011, 0015).
// 띠는 왼쪽(내용)과 오른쪽(상태)으로 나누고, 좁으면 왼쪽부터 줄인다.
import "go:github.com/charmbracelet/lipgloss"
import "go:github.com/charmbracelet/x/ansi"
import "go:strings"
import "go:time"

/// 하단 힌트 하나. 설명은 흐리게, 키는 진하게 그린다.
pub enum Hint {
  /// 설명 다음 키: `prompt { }`
  Key { desc: string, key: string },
  /// 키가 단어 첫 글자인 토글: `[T]hinking`
  Mnemonic { key: string, rest: string },
  /// 뒤 힌트들을 묶는 이름: `move`, `show`
  Label(string),
}

fn hint(desc: string, key: string) -> Hint {
  Hint.Key { desc, key }
}

fn mnemonic(key: string, rest: string) -> Hint {
  Hint.Mnemonic { key, rest }
}

fn label(text: string) -> Hint {
  Hint.Label(text)
}

/// 헤더에서 현재 폴더 범위를 나타내는 기호 (라벨 대신, 0018)
pub const CWD_MARK = "📂"

/// 힌트 묶음 사이 구분
pub const HINT_GROUP_SEP = " | "

fn spaces(n: int) -> string {
  strings.Repeat(" ", max(n, 0))
}

/// 폭 width 의 띠 한 줄. left/right 는 base 바탕으로 이미 그린 조각이다.
/// 넘치면 left 를 자르고, right 만으로도 넘치면 right 도 자른다.
pub fn fit(
  left: string,
  right: string,
  width: int,
  base: lipgloss.Style,
) -> string {
  let mut r = right
  if ansi.StringWidth(r) > width - 2 {
    r = ansi.Truncate(r, max(width - 2, 0), "…")
  }
  let rw = ansi.StringWidth(r)
  let sep = if rw > 0 { 1 } else { 0 }
  let room = width - rw - sep
  let mut l = left
  if ansi.StringWidth(l) > room { l = ansi.Truncate(l, max(room, 0), "…") }
  let gap = width - ansi.StringWidth(l) - rw
  l + base.Render(spaces(gap)) + r
}

fn hint_text(h: Hint) -> string {
  match h {
    Hint.Key { desc, key } => desc + " " + key,
    Hint.Mnemonic { key, rest } => "[" + key + "]" + rest,
    Hint.Label(text) => text,
  }
}

fn render_hint(h: Hint, base: lipgloss.Style) -> string {
  let key = over(lipgloss.NewStyle().Bold(true), base)
  let desc = over(lipgloss.NewStyle().Faint(true), base)
  match h {
    Hint.Key { desc: d, key: k } => desc.Render(d + " ") + key.Render(k),
    Hint.Mnemonic { key: k, rest } => desc.Render("[") + key.Render(k) +
    desc.Render("]" + rest),
    Hint.Label(text) => over(lipgloss.NewStyle().Faint(true).Italic(true), base).Render(
      text,
    ),
  }
}

/// 힌트를 한 줄로 펼친다: (앞 구분, 힌트). 묶음 사이는 ` | `, 힌트 사이는 gap, 이름(Label) 뒤는 한 칸.
fn layout_hints(
  groups: Slice<Slice<Hint>>,
  labels: bool,
  gap: string,
) -> (Slice<string>, Slice<Hint>) {
  let mut seps = Slice.new<string>()
  let mut items = Slice.new<Hint>()
  for g in groups {
    let mut first = true
    let mut after_label = false
    for h in g {
      let is_label = if let Hint.Label(_) = h { true } else { false }
      if is_label && !labels { continue }
      let sep = if items.is_empty() {
        ""
      } else if first {
        HINT_GROUP_SEP
      } else if after_label { " " } else { gap }
      seps = seps.append(sep)
      items = items.append(h)
      first = false
      after_label = is_label
    }
  }
  (seps, items)
}

fn hints_width(seps: Slice<string>, items: Slice<Hint>) -> int {
  let mut w = 0
  for (i, h) in items.enumerate() {
    w += ansi.StringWidth(seps[i] + hint_text(h))
  }
  w
}

/// 키 힌트 묶음을 폭 안에 그린다. 다 들어가지 않으면 차례로 줄인다:
/// 힌트 사이 두 칸 -> 한 칸, 묶음 이름(move, show) 생략, 그래도 넘치면 뒤에서부터 자른다(앞쪽이 더 중요한 키).
/// 자를 때 이름은 뒤 힌트까지 들어갈 때만, 묶음 구분은 다음 힌트가 들어갈 때만 그린다.
pub fn render_hints(
  groups: Slice<Slice<Hint>>,
  width: int,
  base: lipgloss.Style,
) -> string {
  let mut level = 2
  for (k, (labels, gap)) in [(true, "  "), (true, " ")].enumerate() {
    let (s, it) = layout_hints(groups, labels, gap)
    if 1 + hints_width(s, it) <= width {
      level = k
      break
    }
  }
  let gap = if level == 0 { "  " } else { " " }
  let (seps, items) = layout_hints(groups, level < 2, gap)
  let faint = over(lipgloss.NewStyle().Faint(true), base)
  let mut out = base.Render(" ")
  let mut used = 1
  for (i, h) in items.enumerate() {
    let mut w = ansi.StringWidth(seps[i] + hint_text(h))
    if let Hint.Label(_) = h {
      if i + 1 >= items.length() { break }
      w += ansi.StringWidth(seps[i + 1] + hint_text(items[i + 1]))
    }
    if used + w > width { break }
    out += faint.Render(seps[i]) + render_hint(h, base)
    used += ansi.StringWidth(seps[i] + hint_text(h))
  }
  out
}

/// 모달 안 키 안내 한 줄: 하단 힌트와 같은 표기, 바탕 없이 왼쪽 여백 없이.
pub fn modal_hints(groups: Slice<Slice<Hint>>, width: int) -> string {
  strings.TrimPrefix(render_hints(groups, width + 1, lipgloss.NewStyle()), " ")
}

/// 둥근 테두리 상자. 제목은 위 테두리에, 키 안내와 위치(right)는 아래 테두리에 넣는다.
/// lines 는 폭 inner 안이어야 한다. 아래 테두리에 다 들어가지 않으면 키 안내를 줄인다.
pub fn framed_box(
  title: string,
  lines: Slice<string>,
  inner: int,
  hints: Slice<Slice<Hint>>,
  right: string,
) -> string {
  let b = st_border()
  let t = " " + title + " "
  let tw = ansi.StringWidth(t)
  let w = max(inner, tw + 1)
  let mut out = [
    b.Render("╭─") + st_title().Render(t) +
    b.Render(strings.Repeat("─", max(w + 1 - tw, 0)) + "╮"),
  ]
  for l in lines {
    let pad = spaces(w - ansi.StringWidth(l))
    out = out.append(b.Render("│") + " " + l + pad + " " + b.Render("│"))
  }
  let r = if right == "" { "" } else { " " + right + " " }
  let room = w - ansi.StringWidth(r) - 2
  let h = modal_hints(hints, room)
  let left = if h == "" { "" } else { " " + h + " " }
  let fill = max(w + 1 - ansi.StringWidth(left) - ansi.StringWidth(r) - 1, 0)
  out = out.append(
    b.Render("╰─") + left + b.Render(strings.Repeat("─", fill)) +
    st_faint().Render(r) +
    b.Render("─╯"),
  )
  out.join("\n")
}

/// 모달: 배경 화면(bg)을 흐리게 깔고 그 위 가운데에 box 를 얹는다.
/// 배경은 색을 벗기고 흐리게 그린다. 넓은 글자가 상자 경계에 걸리면 빈칸으로 채운다.
pub fn overlay(bg: string, box: string, width: int, height: int) -> string {
  let dim = st_faint()
  let mut rows = bg.split("\n").map(ansi.Strip)
  while rows.length() < height {
    rows = rows.append("")
  }
  // 화면보다 넓은 상자는 잘라 낸다 (줄이 넘어가 화면이 밀리지 않게)
  let lines = box.split("\n").map(|l| ansi.Truncate(l, width, ""))
  let mut bw = 0
  for l in lines {
    bw = max(bw, ansi.StringWidth(l))
  }
  let x = max((width - bw) / 2, 0)
  let y = max((height - lines.length()) / 2, 0)
  let mut out = Slice.new<string>()
  for (i, row) in rows.enumerate() {
    if i >= height { break }
    let k = i - y
    if k < 0 || k >= lines.length() {
      out = out.append(dim.Render(row))
      continue
    }
    let left = ansi.Truncate(row, x, "")
    // TruncateLeft 는 경계에 걸린 넓은 글자를 남기므로, 남는 폭을 넘으면 앞 글자를 빼고 빈칸으로 채운다
    let want = max(ansi.StringWidth(row) - x - bw, 0)
    let mut right = ansi.TruncateLeft(row, x + bw, "")
    while ansi.StringWidth(right) > want {
      right = right.runes()[1..] as string
    }
    let l = lines[k]
    out = out.append(
      dim.Render(left + spaces(x - ansi.StringWidth(left))) + l +
      spaces(bw - ansi.StringWidth(l)) +
      dim.Render(spaces(want - ansi.StringWidth(right)) + right),
    )
  }
  out.join("\n")
}

/// 하단 줄: 상태 메시지가 있으면 힌트 대신 보여준다(잠시 뒤 사라진다, 0015).
/// lead 는 힌트 앞에 붙는 입력 상태(검색어), right 는 위치/모니터링 같은 상태.
pub fn footer(
  status: string,
  lead: string,
  hints: Slice<Slice<Hint>>,
  right: string,
  width: int,
) -> string {
  let base = st_status()
  let r = if right == "" { "" } else { base.Render(right + " ") }
  let room = width - ansi.StringWidth(r) - 1
  let left = if status != "" {
    base.Render(" " + status)
  } else if lead != "" {
    let l = base.Render(" " + lead + " ")
    l + render_hints(hints, room - ansi.StringWidth(l), base)
  } else {
    render_hints(hints, room, base)
  }
  fit(left, r, width, base)
}

/// 헤더의 앱 이름 (버전이 비면 이름만)
pub fn app_title(version: string) -> string {
  let name = "Claude code history viewer"
  if version == "" { name } else { f"{name} {version}" }
}

/// 헤더에서 위치(breadcrumb)에 최소한 남길 폭. 이보다 좁아지면 앱 이름을 뺀다.
const CRUMBS_MIN = 20

/// 상단 띠: 배지 ` CCi ` + 앱 이름과 버전 | 위치(breadcrumb), 오른쪽에 요약.
/// 위치가 길면 `…` 로 줄이고, 위치에 CRUMBS_MIN 칸도 남지 않으면 앱 이름을 빼고 배지와 위치만 남긴다.
pub fn header_bar(
  version: string,
  crumbs: string,
  right: string,
  width: int,
) -> string {
  let base = st_bar()
  let faint = over(st_faint(), base)
  let badge = st_badge().Render(" CCi ")
  let r = if right == "" { "" } else { faint.Render(right + " ") }
  let title = badge + base.Render(" - " + app_title(version)) +
  faint.Render(HINT_GROUP_SEP)
  let need = ansi.StringWidth(title) + min(ansi.StringWidth(crumbs), CRUMBS_MIN)
  let left = if need + ansi.StringWidth(r) + 1 <= width {
    title + crumbs
  } else {
    badge + base.Render(" ") + crumbs
  }
  fit(left, r, width, base)
}

fn parse_local(ts: string) -> Option<time.Time> {
  time.Parse(time.RFC3339, ts).ok().map(|t| t.Local())
}

/// 목록의 날짜 묶음: 오늘, 어제, 최근 7일, 그 이전은 월 단위
pub fn group_label(ts: string, now: time.Time) -> string {
  let Some(t) = parse_local(ts) else {
    return "날짜 없음"
  }
  let day = t.Format("2006-01-02")
  if day == now.Format("2006-01-02") { return "오늘" }
  if day == now.AddDate(0, 0, -1).Format("2006-01-02") { return "어제" }
  if now.Sub(t) < (7 * 24 as time.Duration) * time.Hour { return "최근 7일" }
  t.Format("2006년 1월")
}

/// 목록 항목 오른쪽 시각: 이틀 안이면 시:분, 올해면 월-일 시:분, 아니면 날짜
pub fn short_time(ts: string, now: time.Time) -> string {
  let Some(t) = parse_local(ts) else {
    return ""
  }
  let day = t.Format("2006-01-02")
  if day == now.Format("2006-01-02") || day == now
    .AddDate(0, 0, -1)
    .Format("2006-01-02") {
    return t.Format("15:04")
  }
  if t.Year() == now.Year() { return t.Format("01-02 15:04") }
  day
}

/// 대화의 시작~끝 시각. 같은 날이면 끝은 시:분만.
pub fn time_range(first: string, last: string) -> string {
  let Some(a) = parse_local(first) else {
    return ""
  }
  let start = a.Format("2006-01-02 15:04")
  let Some(b) = parse_local(last) else {
    return start
  }
  if b.Sub(a) < time.Minute { return start }
  let end = if a.Format("2006-01-02") == b.Format("2006-01-02") {
    b.Format("15:04")
  } else {
    b.Format("2006-01-02 15:04")
  }
  f"{start} – {end}"
}

/// 프롬프트 앞 시간 구분선: 앞 메시지와 5분 이상 떨어졌을 때만. 날짜가 바뀌면 날짜도.
pub fn time_gap_label(prev: string, cur: string) -> string {
  let Some(a) = parse_local(prev) else {
    return ""
  }
  let Some(b) = parse_local(cur) else {
    return ""
  }
  if b.Sub(a) < (5 as time.Duration) * time.Minute { return "" }
  if a.Format("2006-01-02") == b.Format("2006-01-02") {
    b.Format("15:04")
  } else {
    b.Format("2006-01-02 15:04")
  }
}

/// 목록의 날짜 묶음 제목. 줄 끝까지 흐린 선을 그어 묶음 경계를 보인다.
/// 오른쪽 1칸은 항목 시각 뒤 여백과 맞춘다.
pub fn group_header(label: string, width: int) -> string {
  let rule = max(width - ansi.StringWidth(label) - 4, 0)
  st_group().Render("  " + label) +
  st_faint().Render(" " + strings.Repeat("─", rule))
}

/// 대화 헤더와 본문 사이 흐린 가로선 (본문 왼쪽 여백 1칸과 맞춘다)
pub fn header_rule(width: int) -> string {
  st_faint().Render(" " + strings.Repeat("─", max(width - 2, 0)))
}

/// ─── label ─── 가운데 정렬 구분선
pub fn divider(label: string, width: int) -> string {
  let text = f" {label} "
  let side = max((width - ansi.StringWidth(text)) / 2, 2)
  st_faint().Render(
    strings.Repeat("─", side) + text +
    strings.Repeat("─", max(width - side - ansi.StringWidth(text), 2)),
  )
}

/// 목록 화면의 한 줄: 묶음 사이 빈 줄, 묶음 제목, 세션 항목의 몇 번째 줄
pub enum ListLine {
  Gap,
  Group(string),
  Item { row: int, part: int },
}

/// 목록 줄 배치. rows 의 i 번째 세션 시각이 times[i].
pub fn list_lines(
  times: Slice<string>,
  per_item: int,
  now: time.Time,
) -> Slice<ListLine> {
  let mut out = Slice.new<ListLine>()
  let mut prev = ""
  for (i, ts) in times.enumerate() {
    let label = group_label(ts, now)
    if i == 0 || label != prev {
      if i > 0 { out = out.append(ListLine.Gap) }
      out = out.append(ListLine.Group(label))
      prev = label
    }
    for part in 0..per_item {
      out = out.append(ListLine.Item { row: i, part })
    }
  }
  out
}

/// row 번째 항목의 (첫 줄, 마지막 줄). 바로 위가 묶음 제목이면 첫 줄을 제목으로 잡는다.
pub fn item_bounds(lines: Slice<ListLine>, row: int) -> (int, int) {
  let mut first = -1
  let mut last = -1
  for (i, l) in lines.enumerate() {
    if let ListLine.Item { row: r, .. } = l {
      if r == row {
        if first < 0 { first = i }
        last = i
      }
    }
  }
  if first > 0 { if let ListLine.Group(_) = lines[first - 1] { first -= 1 } }
  (first, last)
}
