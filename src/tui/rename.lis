// 세션 제목 변경 입력창 (R). 목록에서는 선택한 세션, 대화 화면에서는 현재 세션 (docs/decisions/0012).
import "go:github.com/charmbracelet/bubbletea"
import "go:github.com/charmbracelet/lipgloss"

import "model"
import "session"

/// 열려 있는 제목 입력창
pub struct RenameInput {
  pub path: string,
  pub original: string,
  pub input: string,
}

impl App {
  /// 입력창을 연다. 기존 제목을 채워 두어 고쳐 쓰기 쉽게 한다.
  pub fn ask_rename(self: mut Ref<Self>, s: model.Session) {
    if s.path == "" { return }
    self.renaming = Some(
      RenameInput { path: s.path, original: s.title, input: s.title },
    )
    self.start_input(s.title)
  }

  pub fn on_rename_key(
    self: mut Ref<Self>,
    r: RenameInput,
    key: tea.KeyMsg,
    k: string,
  ) -> Option<tea.Cmd> {
    match k {
      "esc" => {
        self.renaming = None
        self.status = "rename cancelled"
      },
      "enter" => {
        self.renaming = None
        self.apply_rename(r)
      },
      _ => return Some(self.feed_input(key)),
    }
    None
  }

  fn apply_rename(self: mut Ref<Self>, r: RenameInput) {
    let title = session.clean_title(r.input)
    if title == "" {
      self.status = "title is empty, not renamed"
      return
    }
    if title == r.original {
      self.status = "title unchanged"
      return
    }
    match session.rename_session(self.opts.root, r.path, title) {
      Ok(saved) => {
        // 목록 메타와 열린 대화를 파일에서 다시 읽는다 (모니터링 이벤트와 같은 경로)
        self.on_files([r.path])
        if self.has_conv && self.current.path == r.path {
          if let Ok(s) = session.load_meta(r.path) { self.current = s }
        }
        self.status = f"renamed: {saved}"
      },
      Err(e) => self.status = f"rename failed: {e}",
    }
  }

  pub fn view_rename(self: Ref<Self>, r: RenameInput) -> string {
    let w = max(min(self.width - 8, 72), 16)
    let input = self.input_line(r.input, w - 2)
    let lines = [
      st_title().Render("세션 제목 변경"),
      st_faint().Render(clip("현재: " + r.original, w)),
      "",
      st_user().Render("›") + " " + input,
      "",
      modal_hints(
        [
          [hint("save", "enter"), hint("cancel", "esc")],
          [hint("start/end", "^a ^e"), hint("delete before/after", "^u ^k")],
        ],
        w,
      ),
    ]
    let box = st_box().Width(w + 2).Render(lines.join("\n"))
    lipgloss.Place(
      self.width,
      self.height,
      lipgloss.Center,
      lipgloss.Center,
      box,
    )
  }
}
