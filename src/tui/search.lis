// 대화 뷰 검색 (Phase 3). 하이라이트 치환은 하지 않고, ANSI 를 벗긴 줄에서 매치 줄을 찾아
// 그 위치로 점프하고 "i/m" 카운트를 보여준다 (docs/decisions/0007).
import "go:charm.land/bubbletea/v2"
import "go:github.com/charmbracelet/x/ansi"
import "go:strings"

impl App {
  pub fn search_active(self: Ref<Self>) -> bool {
    self.search() != ""
  }

  /// 렌더된 내용에서 검색어가 있는 줄 번호들을 다시 구한다.
  pub fn update_matches(self: mut Ref<Self>) {
    let Some(c) = self.open else {
      return
    }
    let mut found = Slice.new<int>()
    let q = strings.ToLower(c.search)
    if q != "" {
      if c.plain_lines.is_empty() {
        c.plain_lines = strings.ToLower(ansi.Strip(c.content)).split("\n")
      }
      for (i, line) in c.plain_lines.enumerate() {
        if line.contains(q) { found = found.append(i) }
      }
    }
    c.matches = found
    // 토글이나 새 메시지로 매치 수가 줄어도 "8/3" 처럼 어긋나지 않게 한다
    c.match_idx = min(c.match_idx, max(found.length() - 1, 0))
  }

  /// dir=1 이면 현재 줄 다음 매치, -1 이면 이전 매치. 끝에서는 반대쪽으로 돈다.
  pub fn jump_match(self: mut Ref<Self>, dir: int, include_current: bool) {
    let Some(c) = self.open else {
      return
    }
    let n = c.matches.length()
    if n == 0 { return }
    let y = self.vp.YOffset()
    let mut pick = if dir > 0 { 0 } else { n - 1 }
    if dir > 0 {
      for (i, line) in c.matches.enumerate() {
        if line > y || (include_current && line == y) {
          pick = i
          break
        }
      }
    } else {
      for (i, line) in c.matches.enumerate() {
        if line < y { pick = i }
      }
    }
    c.match_idx = pick
    self.vp.SetYOffset(c.matches[pick])
  }

  pub fn on_search_key(
    self: mut Ref<Self>,
    key: tea.KeyPressMsg,
    k: string,
  ) -> Option<tea.Cmd> {
    match k {
      "esc" => {
        self.clear_search()
        self.mode = Mode.Normal
      },
      "enter" => self.mode = Mode.Normal,
      _ => return Some(self.feed_input(key)),
    }
    None
  }

  /// 검색어가 바뀌면 매치를 다시 찾고 첫 매치로 간다
  pub fn search_changed(self: mut Ref<Self>) {
    self.update_matches()
    self.jump_match(1, true)
    self.ensure_rendered()
  }

  pub fn search_status(self: Ref<Self>) -> string {
    let search = self.search()
    let matches = self.matches()
    if !self.search_editing() && search == "" { return "" }
    let count = if matches.is_empty() {
      "No match"
    } else {
      f"{self.match_idx() + 1}/{matches.length()}"
    }
    let query = if self.search_editing() {
      self.input_line(search, max(self.width / 3, 12))
    } else {
      search
    }
    f"/{query}  [{count}]"
  }
}
