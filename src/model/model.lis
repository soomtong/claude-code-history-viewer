// 대화 복기에 필요한 도메인 타입. 파싱 규칙은 docs/decisions/0002 참고.

pub enum Role {
  #[default]
  User,
  Assistant,
}

impl Role {
  pub fn label(self) -> string {
    match self {
      Role.User => "user",
      Role.Assistant => "assistant",
    }
  }
}

/// Edit/MultiEdit 의 old/new 한 쌍.
pub struct EditPair {
  pub old_text: string,
  pub new_text: string,
}

/// Write/Edit/MultiEdit/NotebookEdit 도구 입력에서 뽑은 코드 변경.
pub struct CodeChange {
  pub tool: string,
  pub file_path: string,
  pub content: string, // Write, NotebookEdit 의 전체 내용
  pub edits: Slice<EditPair>, // Edit, MultiEdit 의 치환 목록
}

pub enum Block {
  Text(string),
  Thinking(string),
  ToolUse { name: string, summary: string, code: Option<CodeChange> },
  ToolResult { text: string, is_error: bool },
  Image,
  /// `<command-name>` 같은 메타 태그로 시작하는 user 텍스트
  Meta(string),
  /// 알 수 없는 블록 type
  Unknown(string),
}

pub struct Message {
  pub id: string, // assistant 는 message.id, user 는 줄의 uuid
  pub role: Role,
  pub time: string, // RFC3339 문자열 (원문 그대로)
  pub is_prompt: bool, // 사용자가 직접 입력한 프롬프트인지
  pub blocks: Slice<Block>,
}

impl Message {
  /// 표시 대상 텍스트(Text 블록)만 이어 붙인다.
  pub fn text(self) -> string {
    let mut parts: Slice<string> = []
    for b in self.blocks {
      if let Block.Text(t) = b { parts = parts.append(t) }
    }
    parts.join("\n\n")
  }

  pub fn has_text(self) -> bool {
    self.blocks.any(|b| match b {
      Block.Text(t) => t.length() > 0,
      _ => false,
    })
  }

  pub fn code_changes(self) -> Slice<CodeChange> {
    let mut out: Slice<CodeChange> = []
    for b in self.blocks {
      if let Block.ToolUse { code: Some(c), .. } = b { out = out.append(c) }
    }
    out
  }
}

/// 목록 화면용 세션 메타.
pub struct Session {
  pub id: string,
  pub path: string,
  pub project: string, // projects/ 아래 디렉터리 이름 (인코딩된 cwd)
  pub cwd: string,
  pub git_branch: string,
  pub title: string, // 표시용 제목 (custom > ai > 첫 프롬프트)
  pub custom_title: Option<string>,
  pub ai_title: Option<string>,
  pub first_prompt: string,
  pub started: string,
  pub updated: string,
  pub msg_count: int, // 병합 후 메시지 수 (프롬프트 + assistant 메시지)
  pub prompt_count: int,
  pub size: int64,
  pub mtime: int64, // 파일 mtime (unix 초)
  pub continued_in: Option<string>,
}
