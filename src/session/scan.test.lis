import "go:os"
import "go:path/filepath"
import "go:time"

const SID_A = "11111111-2222-4333-8444-555555555555"

const SID_B = "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"

fn copy_fixture(name: string, dst: string) {
  let data = os.ReadFile(fixture(name)).unwrap_or([])
  let _ = os.MkdirAll(filepath.Dir(dst), 0o755)
  let _ = os.WriteFile(dst, data, 0o644)
}

/// 임시 projects 트리: 두 프로젝트, 세션 아닌 파일/디렉터리 포함
fn make_tree() -> string {
  let root = os.MkdirTemp("", "cci-scan-").unwrap_or("/nonexistent")
  let demo = filepath.Join(root, encode_path("/work/demo-app"))
  let other = filepath.Join(root, encode_path("/work/other"))
  copy_fixture("basic.jsonl", filepath.Join(demo, SID_A + ".jsonl"))
  copy_fixture("untitled.jsonl", filepath.Join(other, SID_B + ".jsonl"))
  let _ = os.MkdirAll(filepath.Join(demo, "memory"), 0o755)
  let _ = os.WriteFile(
    filepath.Join(demo, "memory", "MEMORY.md"),
    "x".bytes(),
    0o644,
  )
  let _ = os.WriteFile(
    filepath.Join(demo, ".session-aliases"),
    "x".bytes(),
    0o644,
  )
  let _ = os.WriteFile(filepath.Join(demo, "notes.jsonl"), "{}".bytes(), 0o644)
  // other 를 더 최근으로
  let later = time.Now().Add(time.Minute)
  let _ = os.Chtimes(filepath.Join(other, SID_B + ".jsonl"), later, later)
  root
}

#[test("cwd 인코딩은 영숫자 외 문자를 - 로")]
fn encodes_path() {
  assert encode_path("/Users/kez/Repository") == "-Users-kez-Repository"
  assert encode_path("/a/.claude/worktrees/x_y") == "-a--claude-worktrees-x-y"
}

#[test("UUID 이름의 jsonl 만 세션 파일")]
fn session_file_names() {
  assert is_session_file(SID_A + ".jsonl")
  assert is_session_file("AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE.jsonl")
  assert !is_session_file("notes.jsonl")
  assert !is_session_file(SID_A + ".desktop-released.json")
  assert !is_session_file("../" + SID_A + ".jsonl")
}

#[test("범위별 프로젝트 디렉터리")]
fn scopes() {
  let root = make_tree()
  defer {
    let _ = os.RemoveAll(root)
  }
  assert project_dirs(root, "/work/demo-app", Scope.Cwd).length() == 1
  assert project_dirs(root, "/work/nothing", Scope.Cwd).length() == 0
  assert project_dirs(root, "/work/demo-app/.claude/worktrees/w1", Scope.Cwd).length() ==
  0
  assert project_dirs(root, "/work/demo-app/.claude/worktrees/w1", Scope.Parent).length() ==
  1
  assert project_dirs(root, "/work/demo-app", Scope.All).length() == 2
}

#[test("목록은 세션 파일만, mtime 최신순")]
fn lists_sessions() {
  let root = make_tree()
  defer {
    let _ = os.RemoveAll(root)
  }
  let all = list_sessions(project_dirs(root, "/", Scope.All))
  assert all.length() == 2
  assert all[0].id == SID_B
  assert all[1].id == SID_A
  assert all[1].title == "My greet session"
  assert all[1].cwd == "/work/demo-app"
  let Some(p) = find_session(root, SID_A) else {
    assert false
    return
  }
  assert p.ends_with(SID_A + ".jsonl")
  assert find_session(root, "00000000-0000-4000-8000-000000000000").is_none()
}
